{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/((?:fr/|ar/)?esim/(?:morocco|egypt|europe|turkiye|spain|france|saudi-arabia|united-arab-emirates))/?",
      "dest": "/$1/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
